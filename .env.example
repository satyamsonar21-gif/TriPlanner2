# Triplanner Environment Configuration
# Copy this file to .env.local for local development

# Supabase Credentials (Browser-Safe Public Credentials)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Metadata
VITE_APP_NAME=Triplanner
VITE_APP_URL=http://localhost:5173

# Optional Feature Flags
VITE_ENABLE_MOCK_DATA=true

# ============================================================
# PHASE 03 — LOCATION, MAPS & ROUTING CONFIGURATION
# ============================================================
# Provider mode: 'auto' | 'google' | 'demo' | 'mock'
# - 'auto': uses Google Maps when VITE_GOOGLE_MAPS_BROWSER_KEY is set,
#           falls back to deterministic demo fixtures in dev/demo when VITE_ENABLE_MOCK_DATA=true,
#           and fails explicitly in production if credentials are missing.
VITE_MAPS_PROVIDER_MODE=auto

# Browser-Safe Restricted Google Maps API Key (HTTP Referrer Restricted)
# Enabled APIs: Maps JavaScript API, Places API (New)
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Server-Only Google Maps Web Service Key (NEVER prefix with VITE_)
# Used only in server/Edge Functions for server-side Routes API / Geocoding API calls
GOOGLE_MAPS_SERVER_KEY=

# Configurable Default Safety Buffer (minutes) between consecutive itinerary stops
VITE_DEFAULT_TRANSFER_BUFFER_MINUTES=15

# ============================================================
# PHASE 05 — AI INTELLIGENCE LAYER CONFIGURATION
# ============================================================
# Browser-Safe AI Provider Mode: 'auto' | 'gemini' | 'deterministic' | 'disabled'
# - 'auto': uses server-side Gemini Edge Function when available, falls back to
#           deterministic grounded intelligence in dev/demo when VITE_ENABLE_MOCK_DATA=true,
#           and shows controlled AI unavailable state in production if unconfigured.
VITE_AI_PROVIDER_MODE=auto

# Browser-Safe AI Feature Flags
VITE_AI_ASSISTANT_ENABLED=true
VITE_AI_OPERATOR_COPILOT_ENABLED=true
VITE_AI_PLANNING_ENABLED=true
VITE_AI_EXPLANATIONS_ENABLED=true
VITE_AI_MUTATION_ASSISTANCE_ENABLED=true

# Optional Server-Side AI Edge Function Endpoint
VITE_AI_EDGE_FUNCTION_URL=

# ============================================================
# SERVER-ONLY SECRETS (NEVER PREFIX WITH VITE_)
# ============================================================
# Used ONLY in Supabase Edge Functions (supabase/functions/ai-intelligence)
# or server-side runtime. Never exposed to browser bundles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

